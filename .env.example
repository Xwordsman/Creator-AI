# Copy to .env. Generate a random URL-safe value (hex recommended), do not keep this placeholder.
DB_PASSWORD=replace-with-a-random-hex-secret

# Docker local preview. For a public server use https://creator.example.com.
APP_ORIGIN=http://localhost
SITE_ADDRESS=http://localhost
HTTP_PORT=80
HTTPS_PORT=443
MODEL_MODE=mock
# Optional real models: set MODEL_MODE=configured and BOTH values below.
# Generate 32 random bytes as 64 hex digits. Keep this key stable and back it up separately.
# This is the encryption master key, NOT a provider API key. Provider keys are entered in the UI.
MODEL_ENCRYPTION_KEY=
# Exact HTTPS hosts, comma-separated; include :port for non-default ports. No wildcards.
MODEL_ALLOWED_HOSTS=
# MODEL_ALLOW_LOCAL=true is for isolated non-production loopback fixtures only.
# Production rejects this setting. Private, metadata and reserved destinations stay blocked.

# Host development / CLI only; Compose sets its own internal service URLs.
# For loopback-only API and worker health endpoints, set BIND_HOST=127.0.0.1.
# Change APP_ORIGIN to http://localhost:5173 when using the Vite dev server.
# Keep the secret in this URL in sync with DB_PASSWORD.
DATABASE_URL=postgres://creator:replace-with-a-random-hex-secret@127.0.0.1:5432/creator
REDIS_URL=redis://127.0.0.1:6379/0
